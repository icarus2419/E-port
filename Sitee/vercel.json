{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/poker.py": {
      "includeFiles": "poker/lib/**"
    }
  },
  "redirects": [
    {
      "source": "/project/Secure-Document-Approval/",
      "destination": "/project/securedoc-combined/",
      "permanent": true
    },
    {
      "source": "/project/Secure-Document-Approval/demo/",
      "destination": "/project/securedoc-combined/demo/",
      "permanent": true
    },
    {
      "source": "/project/Secure-Document-Approval/demo/app/",
      "destination": "/project/securedoc-combined/demo/app/",
      "permanent": true
    },
    {
      "source": "/project/Secure-Document-Approval/:path*",
      "destination": "/project/securedoc-combined/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/poker?route=:path*" }
  ]
}
